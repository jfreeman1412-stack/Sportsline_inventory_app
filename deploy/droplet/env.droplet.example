# Copy to /home/sportsline-inventory/.env on the droplet, fill in, then: chmod 600 .env
# Generate secrets with: openssl rand -hex 32

# Sytist's order tables (read-only user). Database name = SYTIST_DB_NAME in
# /home/sytist_docker/.env
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=inventory_reader
MYSQL_PASSWORD=
MYSQL_DATABASE=

# The inventory app's own database, in the same MySQL container
APP_MYSQL_HOST=mysql
APP_MYSQL_PORT=3306
APP_MYSQL_USER=inventory_app
APP_MYSQL_PASSWORD=
APP_MYSQL_DATABASE=sportsline_inventory

SHIPSTATION_API_KEY=
SHIPSTATION_API_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=info@sportslinephotography.com

INTERNAL_SYNC_TOKEN=
SESSION_SECRET=
POLL_INTERVAL_SECONDS=90
